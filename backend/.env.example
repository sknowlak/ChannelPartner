PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/cross_crm_channel_partner
DUPLICATE_PROTECTION_DAYS=30

# Required. The server refuses to start without a random value of at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ADMIN_TOKEN_TTL=8h
DEFAULT_ADMIN_EMAIL=admin@leadrat.example
# Used only by `npm run seed` to create the first admin - change it, and
# change the password after the first login.
DEFAULT_ADMIN_PASSWORD=Admin@12345

# Optional - comma-separated web origins allowed to call the API from a
# browser (e.g. https://partners.example.com,https://admin.example.com).
# Leave empty for local development (any origin).
CORS_ORIGINS=
# Optional - set to 1 when running behind a reverse proxy / load balancer so
# login rate limiting sees the real client IP.
TRUST_PROXY=
# Optional - webhooks may only target public internet addresses. Set to true
# ONLY for local development against a receiver on your own machine/LAN.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# Optional - Email channel for lead notifications (section 49). Leave
# SMTP_HOST empty and email deliveries are logged as "skipped".
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional - LinkedIn connector (section 59). Client ID/secret of Leadrat's
# LinkedIn developer app (Advertising API, Lead Sync API and Conversions API
# products approved). Never commit the secret.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must be registered exactly under the app's Auth > Authorized redirect URLs.
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/channel-partner/connectors/linkedin/callback
# Where the browser returns after connecting (the partner web app).
PARTNER_APP_URL=http://localhost:5173
# Optional - public HTTPS URL of /api/channel-partner/connectors/linkedin/webhook.
# When set, LinkedIn pushes new leads in seconds; otherwise they are fetched
# every few minutes.
LINKEDIN_WEBHOOK_URL=
# LinkedIn-Version header (YYYYMM) - move forward before LinkedIn sunsets it.
LINKEDIN_API_VERSION=202609
# 64 hex characters - encrypts connector tokens stored in the database.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
